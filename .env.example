# Copy to .env and adjust. The prototype runs with ALL of these disabled.

# --- Reasoning / generation model (OpenAI-compatible endpoint) ---
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1     # Ollama default; swap for any OpenAI-compatible endpoint
LLM_MODEL=qwen2.5:7b-instruct              # open-source; swap for llama3.1:8b, mistral, etc.
LLM_API_KEY=                               # leave blank for local/no-auth endpoints (e.g. Ollama)

# --- Embeddings for trend retrieval ---
EMBED_ENABLED=false
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vision model for fabric/image understanding (Phase 3) ---
# The text model above (LLM_MODEL) may not accept images -- use a dedicated
# vision-capable model here. "auto" (default) = VISION_ENABLED decides mock
# vs. live. Leave VISION_API_KEY blank to reuse LLM_API_KEY.
VISION_ENABLED=false
VISION_PROVIDER=auto
VISION_BASE_URL=http://localhost:11434/v1  # Ollama default (OpenAI-compatible)
VISION_MODEL=qwen2.5vl:7b                  # pull first: `ollama pull qwen2.5vl:7b`
VISION_API_KEY=

# --- Design visualization / image generation (Phase 4) ---
# A third, distinct model from both LLM_MODEL (text) and VISION_MODEL
# (image understanding) -- this one GENERATES images. "auto" (default) =
# VISUALIZATION_ENABLED decides mock vs. live. Leave VISUALIZATION_API_KEY
# blank to reuse LLM_API_KEY. VISUALIZATION_VALIDATION_MODEL blank = reuse
# VISION_MODEL for post-generation visual validation (section 16).
VISUALIZATION_ENABLED=false
VISUALIZATION_PROVIDER=auto
VISUALIZATION_BASE_URL=http://localhost:11434/v1
VISUALIZATION_MODEL=qwen-image-edit        # reference-conditioned image editing (1-3 input images)
VISUALIZATION_API_KEY=
VISUALIZATION_MAX_REFERENCE_IMAGES=3
VISUALIZATION_TIMEOUT_S=45
VISUALIZATION_STORAGE_DIR=artifacts/visualizations
VISUALIZATION_VALIDATION_MODEL=

REQUEST_TIMEOUT_S=30
